      {
        "name": "NB_Bronze_Data_Validation",
        "type": "TridentNotebook",
        "description": "Validates the four bronze tables after ingestion: checks row counts against the source files, confirms primary keys are present and unique, and flags null or malformed values before any transformation runs.",
        "dependsOn": [
          {
            "activity": "CD_Load_Bronze_Applications",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "CD_Load_Bronze_Contacts",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "CD_Load_Bronze_Plans",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "CD_Load_Bronze_Eligibility",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "<NOTEBOOK_ITEM_ID>",
          "workspaceId": "<WORKSPACE_ITEM_ID>"
        }
      },
      {
        "name": "NB_Bronze_To_Silver",
        "type": "TridentNotebook",
        "description": "Transforms the validated bronze tables into the silver layer: standardises column names and data types, trims and normalises text values, removes duplicate records and applies referential joins across applications, contacts, plans and eligibility.",
        "dependsOn": [
          {
            "activity": "NB_Bronze_Data_Validation",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "<NOTEBOOK_ITEM_ID>",
          "workspaceId": "<WORKSPACE_ITEM_ID>"
        }
      },
      {
        "name": "NB_Silver_To_Gold",
        "type": "TridentNotebook",
        "description": "Builds the curated gold layer from silver: derives enrollment status and eligibility-check measures, applies business definitions, and produces the aggregated tables consumed by the semantic model, ontology and data agent.",
        "dependsOn": [
          {
            "activity": "NB_Bronze_To_Silver",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "<NOTEBOOK_ITEM_ID>",
          "workspaceId": "<WORKSPACE_ITEM_ID>"
        }
      },
      {
        "name": "DQ_Gold_Readiness",
        "type": "Lookup",
        "description": "Validates enrollment counts, exception records and reference integrity prior to publication.",
        "dependsOn": [
          {
            "activity": "NB_Silver_To_Gold",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
